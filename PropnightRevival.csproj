<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 is part of Windows 10/11 and the interface runs in WebView2
       (Chromium, shipped with Windows): one small exe, nothing to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PropnightRevival</AssemblyName>
    <RootNamespace>PropnightRevival</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.14.4</Version>
    <Product>Propnight Revival Launcher</Product>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <!-- no debug symbols: the exe must not carry the build machine's folder (PDB path) -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <WebView2Dir>$(NuGetPackageRoot)microsoft.web.webview2\1.0.4258.31\</WebView2Dir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- the interface and the WebView2 SDK files travel inside the exe -->
    <EmbeddedResource Include="ui\index.html" LogicalName="PropnightRevival.ui.index.html" />
    <EmbeddedResource Include="$(WebView2Dir)lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="PropnightRevival.deps.Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(WebView2Dir)lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="PropnightRevival.deps.Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(WebView2Dir)runtimes\win-x64\native\WebView2Loader.dll" LogicalName="PropnightRevival.deps.WebView2Loader.dll" />
  </ItemGroup>
</Project>
